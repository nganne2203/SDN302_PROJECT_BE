{
  "name": "phone-accessories",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "imports": {
    "#configs/*": {
      "default": "./dist/configs/*"
    },
    "#constants/*": {
      "default": "./dist/constants/*"
    },
    "#controllers/*": {
      "default": "./dist/controllers/*"
    },
    "#middlewares/*": {
      "default": "./dist/middlewares/*"
    },
    "#models/*": {
      "default": "./dist/models/*"
    },
    "#providers/*": {
      "default": "./dist/providers/*"
    },
    "#repositories/*": {
      "default": "./dist/repositories/*"
    },
    "#routes/*": {
      "default": "./dist/routes/*"
    },
    "#services/*": {
      "default": "./dist/services/*"
    },
    "#sockets/*": {
      "default": "./dist/sockets/*"
    },
    "#utils/*": {
      "default": "./dist/utils/*"
    },
    "#validations/*": {
      "default": "./dist/validations/*"
    }
  },
  "scripts": {
    "build": "rimraf dist && copyfiles -u 1 \"src/**/*\" dist",
    "predev": "npm run build",
    "dev": "cross-env NODE_ENV=dev concurrently \"copyfiles -u 1 src/**/* dist -w\" \"nodemon -q dist/server.js\"",
    "prod": "cross-env NODE_ENV=prod npm run start",
    "prestart": "npm run build",
    "start": "cross-env NODE_ENV=prod node dist/server.js",
    "prestaging": "npm run build",
    "staging": "cross-env NODE_ENV=staging node dist/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^2.2.1",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rimraf": "^6.1.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@shelf/jest-mongodb": "^6.0.2",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
